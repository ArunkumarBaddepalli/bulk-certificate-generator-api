# All optional. Copy to .env and export, or set in your shell.

# SQLAlchemy URL. Default is a local SQLite file.
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/certs
DATABASE_URL=sqlite:///./certificates.db

# Folder where generated PDFs are written (one sub-folder per job).
CERT_STORAGE_DIR=./storage/certificates

# Hard cap on recipients per request.
MAX_RECIPIENTS_PER_JOB=1000
